generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  password      String?
  isAdmin       Boolean        @default(false)
  smacCoins     Int            @default(1000)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  sessions      Session[]
  smacArticles  SMACArticle[]
  smacPicks     SMACPick[]
  userSMACPicks UserSMACPick[]
  articleVotes  ArticleVote[]
  articleComments ArticleComment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SMACArticle {
  id             String   @id @default(cuid())
  title          String
  gameDate       DateTime
  homeTeam       String
  awayTeam       String
  pick           String
  reasoning      String
  imageUrl       String?
  published      Boolean  @default(false)
  publishRequest Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  authorId       String
  author         User     @relation(fields: [authorId], references: [id])
  votes          ArticleVote[]
  comments       ArticleComment[]
}

model SMACPick {
  id         String   @id @default(cuid())
  date       DateTime
  sport      String
  game       String
  bet        String
  odds       Float
  smacCoins  Int
  result     String?
  yield      Float?
  weekNumber Int
  year       Int
  author     User     @relation(fields: [authorId], references: [id])
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([authorId])
  @@index([year, weekNumber])
}

model UserSMACPick {
  id         String   @id @default(cuid())
  date       DateTime
  sport      String
  game       String
  bet        String
  odds       Float
  smacCoins  Int
  result     String?
  yield      Float?
  weekNumber Int
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  userId     String

  @@index([userId])
  @@index([year, weekNumber])
}

model GlobalSMACCoins {
  id        String   @id @default(cuid())
  balance   Int      @default(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SMACCoinsDistribution {
  id              String    @id @default(cuid())
  isActive        Boolean   @default(false)
  weeklyAmount    Int
  lastDistributed DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ArticleVote {
  id        String   @id @default(cuid())
  vote      Int      // 1 for upvote, -1 for downvote
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  articleId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   SMACArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId])
  @@index([userId])
}

model ArticleComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  articleId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   SMACArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([userId])
}
